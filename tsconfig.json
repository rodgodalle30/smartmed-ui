{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "allowJs": true,
    "isolatedModules": true
  },
  "include": ["src/**/*.vue", "src/**/*.js"]
}
